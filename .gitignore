/backend/.venv
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.python-version

# Environment variables
.env
.env.local
.env.*.local
*.env

# Secrets / Credentials
**/service-account-key.json
**/credentials.json
*.pem
*.key

